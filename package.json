{
  "name": "minbrowser",
  "productName": "MinBrowser",
  "version": "0.1.0",
  "description": "A private browser that keeps your data encrypted on your own disk.",
  "main": "dist/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "hash-wasm": "^4.12.0",
    "tldts": "^7.4.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
