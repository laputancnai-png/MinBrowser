{
  "name": "minbrowser",
  "productName": "MinBrowser",
  "version": "1.2.0",
  "description": "A private browser that keeps your data encrypted on your own disk.",
  "main": "dist/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "test:e2e": "npm run build && node tests/e2e/run.cjs",
    "install-desktop": "sh scripts/install-linux-desktop.sh",
    "version:minor": "node scripts/bump.mjs minor",
    "version:major": "node scripts/bump.mjs major",
    "postinstall": "node scripts/dev-fuses.mjs"
  },
  "devDependencies": {
    "@electron/fuses": "^1.8.0",
    "@ghostery/adblocker": "^2.20.3",
    "@types/node": "^26.6.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "hash-wasm": "^4.12.0",
    "playwright-core": "^1.64.1",
    "tldts": "^7.4.19",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "MinBrowser"
  },
  "desktopName": "minbrowser.desktop"
}
